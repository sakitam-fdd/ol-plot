{
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run -r dev",
    "build": "pnpm run -r build",
    "build:minify": "pnpm run -r build:minify",
    "build:vue2": "cd packages/ol-plot-vue/vue2 && yarn install --frozen-lockfile && yarn build && cd ../../../",
    "copy-file": "cd packages/ol-plot-vue && pnpm postbuild && cd ../../",
    "docs": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:serve": "pnpm --dir docs preview",
    "compat": "pnpm --filter ol-plot test:compat",
    "version": "changeset version",
    "changeset": "changeset",
    "release": "pnpm --filter \"./packages/**\" build && pnpm --filter \"./packages/**\" build:minify && pnpm build:vue2 && pnpm copy-file && pnpm changeset publish",
    "lint": "eslint \"packages/ol-plot/src/**/*.ts\"",
    "prettier": "prettier --parser=typescript --write **/*.{js,ts,md}",
    "test": "pnpm run -r test",
    "type-check": "pnpm --filter ol-plot type-check && pnpm --filter ol-plot build && pnpm --filter ol-plot-vue type-check",
    "test-only": "pnpm run -r test-only",
    "coverage": "pnpm run -r coverage"
  },
  "devDependencies": {
    "@aurorafe/eslint-config-base": "^1.0.1",
    "@aurorafe/eslint-config-ts": "^1.0.1",
    "@aurorafe/eslint-config-vue": "^1.0.1",
    "@changesets/changelog-github": "^0.4.8",
    "@changesets/cli": "^2.25.0",
    "@microsoft/api-extractor": "^7.57.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.40.1",
    "@vitest/coverage-v8": "0.34.1",
    "canvas": "^2.10.2",
    "jsdom": "^20.0.3",
    "esbuild": "^0.15.12",
    "eslint": "^8.30.0",
    "less": "^4.1.3",
    "prettier": "^2.7.1",
    "terser": "^5.17.1",
    "typescript": "^5.9.3",
    "vite": "^4.4.7",
    "vitest": "^0.34.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-externals": "^0.6.2",
    "wait-for-expect": "3.0.2",
    "lint-staged": "^13.0.3",
    "rimraf": "^3.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run lint",
      "pre-push": "pnpm run test"
    }
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "git add"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write",
      "git add"
    ]
  },
  "license": "MIT"
}
